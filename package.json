{
  "name": "response-mock-extension",
  "version": "1.0.0",
  "description": "一个轻量的 Chrome 浏览器扩展，基于 Manifest V3 构建，用于拦截并修改指定 URL 接口的响应数据，方便前端开发调试和接口 Mock 测试。",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist response-mock-extension.zip",
    "build:js": "node scripts/build.mjs",
    "build": "npm run clean && npm run build:js",
    "pack": "npm run build && node scripts/zip.mjs",
    "test": "echo \"No tests configured\""
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3",
    "rimraf": "^6.1.3",
    "terser": "^5.48.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "codemirror": "^6.0.2",
    "vanilla-jsoneditor": "^3.12.0"
  }
}
